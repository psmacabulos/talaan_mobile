# Copy to .env and fill in. Never commit .env.

# The Talaan server the app talks to (docs/SERVER.md).
#
# Checked 2026-10-21: the live API answers at https://bantayaral.com. The
# address docs/SERVER.md still names, https://bantayaral.herokuapp.com, returns
# Heroku's "no such app" page (docs/PROBLEMS-LOG.md, P-007).
#
# Fallback, Talaan on the owner's Mac on the same Wi-Fi as the phone:
# http://<the Mac's address>:3000 (find it with: ipconfig getifaddr en0).
EXPO_PUBLIC_API_URL="https://bantayaral.com"
