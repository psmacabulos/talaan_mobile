{
  "cli": {
    "version": ">= 26.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://bantayaral.com"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "environment": "production"
    }
  }
}
